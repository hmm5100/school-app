# ──────────────────────────────────────────────────────────────────
# .env.example — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية
# لا ترفع .env.local إلى GitHub أبدًا
# ──────────────────────────────────────────────────────────────────

# ── Firebase Configuration ──────────────────────────────────────
# احصل على هذه القيم من: Firebase Console → Project Settings → Web App
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_APP_ID_HERE

# ── Encryption Key ───────────────────────────────────────────────
# يجب أن يكون 32 حرفًا بالضبط (لا أقل ولا أكثر)
# مثال آمن: استخدم مولّد كلمات مرور عشوائية
VITE_ENCRYPTION_KEY=YourSecretEncryptionKey32Chars!!

# ── School Identity ──────────────────────────────────────────────
VITE_SCHOOL_NAME=مدرسة النور
VITE_OWNER_NAME=Mr.Hamdy Mohamed
VITE_APP_VERSION=1.0.0
